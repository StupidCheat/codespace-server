{
  "name": "Mi Codespace",
  "image": "mcr.microsoft.com/devcontainers/universal:latest",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Mi servidor",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install --upgrade pip",
  "remoteUser": "codespace"
}
